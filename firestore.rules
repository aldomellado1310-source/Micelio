rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo el staff admin. Antes se usaba `request.auth != null`, pero el
    // registro público de Auth está habilitado: CUALQUIERA podía crear una
    // cuenta con la API key pública y leer/escribir estos datos. Ahora se exige
    // ser el admin — vía custom claim `admin:true` (preferido, permite sumar
    // staff sin tocar reglas) o el UID del admin actual como respaldo inmediato.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == 'VUm858rENuNVzB4MAMtzLnGb1A63'
      );
    }

    // Catálogo público: lectura libre, escritura solo admin
    match /services/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /staff/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /businessInfo/{id}{ allow read: if true; allow write: if isAdmin(); }

    // Imágenes del sitio (herramienta de reemplazo manual desde el admin):
    // lectura libre porque el landing público las carga para TODOS los
    // visitantes, no solo el staff logueado. Mismo patrón que services/staff.
    match /siteImages/{slot} { allow read: if true; allow write: if isAdmin(); }

    // Vista materializada de disponibilidad (sin PII), mantenida por la Cloud
    // Function onBookingWritten (Admin SDK, no sujeta a estas reglas).
    // Lectura pública para el widget de reservas; nunca escritura de cliente.
    match /availability/{date} { allow read: if true; allow write: if false; }

    // Espejo del perfil de Google Business (puntaje, total de opiniones y las
    // reseñas que devuelve Places), mantenido por refreshGoogleReviews /
    // syncGoogleReviews con Admin SDK. Lectura pública porque la sección de
    // reseñas del landing la pinta para TODOS los visitantes -- mismo patrón
    // que availability/siteImages. La escritura admin existe solo para el
    // campo `manualReviews` que cura el panel: la API key de Places jamás
    // baja al navegador, así que nadie puede "sincronizar" desde el cliente.
    match /googleReviews/{id} { allow read: if true; allow write: if isAdmin(); }

    // Reservas: solo admin lee/crea/edita. La creación pública ya NO pasa
    // por acá -- el widget (public/index.html) llama al callable
    // transaccional `createBooking` (functions/createBooking.js, Admin SDK,
    // no sujeto a estas reglas), que además verifica disponibilidad real
    // antes de escribir (algo que una regla no puede hacer: no puede
    // consultar otras colecciones, solo get()/exists() sobre rutas
    // concretas). Antes de esta fase, cualquiera podía crear una reserva
    // directo sin que NADA verificara solape de horario.
    //
    // delete: if false SIEMPRE (Etapa A, goal 13 del pool ReservaGo) --
    // cancelar una reserva es un cambio de estado (status:'cancelled', vía
    // el callable setBookingStatus), nunca un borrado. Antes de este goal,
    // el panel borraba el documento entero al cancelar (deleteBooking) --
    // ver CLAUDE.md, "Estado conocido". Mismo criterio ya aplicado a
    // tenants/{tenantId} en el goal 8: la regla lo hace estructuralmente
    // imposible, no solo por convención del panel.
    match /bookings/{id} {
      allow read, update: if isAdmin();
      allow create: if isAdmin() && isValidEmail(request.resource.data.get('email', ''));
      allow delete: if false;
    }
    // El email es opcional (un barbero puede agendar por teléfono sin
    // correo): si viene vacío se acepta, pero si trae contenido debe tener
    // formato válido -- mismo regex que usa el widget público
    // (public/index.html) y que isValidBookingPayload() en
    // functions/createBooking.js.
    function isValidEmail(email) {
      return email is string && (email == '' || email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'));
    }
    // Ya NO la invoca ningún `allow` de este archivo -- queda como
    // documentación del criterio que reemplazó al create público, portado
    // (a mano; CEL y JS no comparten código) a isValidBookingPayload() en
    // functions/createBooking.js, donde ahora vive la validación real.
    // tests/rules/createBooking.crosscheck.test.js probó la equivalencia
    // ANTES de este cambio y quedó retirado en el mismo commit que cerró
    // esta rama -- ver el comentario al inicio de ese archivo.
    function isValidBooking() {
      let d = request.resource.data;
      return d.status == 'pending'
        && d.name is string  && d.name.size() > 1
        && d.email is string && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.phone is string && d.phone.size() >= 7
        && d.svcId is string && d.barberId is string
        && d.date is string  && d.time is string
        && d.code is string
        && d.club is string  && (d.club == 'member' || d.club == 'guest');
    }

    // Clientes (v19): nombre, contacto, historial de visitas y fotos (PII).
    // Nunca hay escritura pública directa — el único creador/actualizador es
    // la Cloud Function onBookingCreated (Admin SDK, no sujeta a estas reglas).
    match /patients/{id} { allow read, write: if isAdmin(); }

    // Bloqueos de horario (colación puntual, trámites, etc.): solo admin.
    // El público nunca lee esta colección directo -- se refleja
    // indirectamente como rangos ocupados (sin `reason`) a través de
    // getAvailability, mismo patrón de privacidad que bookings.
    match /scheduleBlocks/{id} { allow read, write: if isAdmin(); }

    // Log de actividad: solo admin. OBSOLETA desde el goal 15 (Etapa A) --
    // log() escribe en memoria y saveAdmin() nunca la persiste (ver
    // CLAUDE.md, "Estado conocido"), así que en la práctica esta colección
    // nunca se escribe. tenants/{tenantId}/auditLog (más abajo) la
    // reemplaza para el modelo tenant-aware: escrita por trigger, no por el
    // panel, así que no depende de que el front "se acuerde" de loguear. Se
    // deja la regla tal cual -- no se borra, por si algún día se decide
    // migrar su historial.
    match /adminLog/{id} { allow read, write: if isAdmin(); }

    // ══ ROLES DE PLATAFORMA (Etapa T, goal 7 del pool ReservaGo) ══
    // platformRole:'superadmin' es un nivel de rol SEPARADO del role de
    // negocio de un tenant (owner/reception/staff+tenantId, goal 14) -- nunca
    // se mezclan en el mismo claim ni en la misma función de reglas.
    // isSuperadmin() a propósito NO participa en isAdmin() (rol de negocio de
    // Scissor White) ni en la regla de aislamiento de tenants (goal 6, exige
    // tenantId) -- un superadmin puro no tiene tenantId, así que esa regla ya
    // lo rechaza sin necesitar ningún caso especial (ver
    // tests/rules/platform-role.rules.test.js).
    function isSuperadmin() {
      return request.auth != null && request.auth.token.platformRole == 'superadmin';
    }

    // stamped(): exige que todo write autenticado deje registrado QUIÉN y
    // CUÁNDO -- Firestore no le entrega esa identidad a un trigger de
    // ninguna otra forma (event.data solo trae el documento). El trigger
    // onTenantWritten (functions/index.js, goal 8) lee updatedBy del
    // documento para atribuir cada fila de platformAuditLog al superadmin
    // real que hizo el cambio. Sin esta regla, cualquiera podría escribir
    // updatedBy con el uid de otra persona y la bitácora mentiría sobre
    // quién hizo qué -- el mismo problema que el goal 15 va a resolver para
    // auditLog de negocio, adelantado acá porque platformAuditLog lo
    // necesita ya.
    function stamped() {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // ══ TENENCIA (Etapa T, goal 5 del pool ReservaGo) ══
    // tenants/{tenantId}: modelo de cliente de la plataforma -- SÍ tiene PII
    // (contactEmail, contactName). Antes del goal 7 esto era `if false` (ni
    // siquiera isAdmin() podía tocarlo) -- ahora que existe platformRole,
    // isSuperadmin() es el gate. isAdmin() es el rol de NEGOCIO de Scissor
    // White (pasará a ser 'owner' de SU tenant en el goal 14) y a propósito
    // NO es el gate acá -- confundiría "dueño de un negocio" con "opera la
    // plataforma completa".
    //
    // Goal 8: create/update exigen stamped() (ver arriba). delete es
    // SIEMPRE false, ni para un superadmin -- "nunca borrar un tenant: es un
    // status, igual que un servicio retirado" (goal 8). A diferencia de
    // services/staff (donde esa regla es solo convención de producto, sin
    // gate en firestore.rules), acá sí se hace cumplir en la regla: perder
    // el registro completo de un cliente de pago es categóricamente peor que
    // perder un servicio del catálogo.
    match /tenants/{tenantId} {
      allow read: if isSuperadmin();
      allow create, update: if isSuperadmin() && stamped();
      allow delete: if false;
    }

    // platformAuditLog/{id}: altas, suspensiones y reactivaciones de tenants
    // (goal 8). Escrito SOLO por el trigger onTenantWritten (Admin SDK, no
    // sujeto a estas reglas) -- igual que adminLog/auditLog, ningún cliente
    // escribe acá directo, para que la bitácora no dependa de que el panel
    // "se acuerde" de loguear (ver el bug ya conocido de adminLog en
    // CLAUDE.md). Lectura solo superadmin -- es información de plataforma
    // (qué clientes existen, quién los dio de alta), no de un tenant
    // individual.
    match /platformAuditLog/{id} { allow read: if isSuperadmin(); allow write: if false; }

    // tenantsByDomain/{dominio} -> {tenantId, slug}: documento público SIN
    // PII para que el cliente resuelva su propio tenant al cargar. La
    // autoridad real del lado servidor es functions/tenant.js#resolveTenantId
    // (lee esta misma colección con Admin SDK, no sujeto a estas reglas) --
    // este doc es solo para que el FRONTEND sepa dónde está parado, ningún
    // callable debe confiar en lo que el cliente diga sobre su propio tenant.
    // Escritura solo Admin SDK -- no existe todavía un alta de tenants desde
    // el cliente (eso es el panel de plataforma, goal 8).
    match /tenantsByDomain/{dominio} { allow read: if true; allow write: if false; }

    // ══ SUBCOLECCIONES POR TENANT (Etapa T, goal 6) ══
    // resources, services, bookings, holds, dataRequests: el
    // aislamiento entre tenants lo garantiza la RUTA del documento (esta
    // regla), no la disciplina de quien escribe cada query -- exactamente el
    // problema que hoy sufre isAdmin() con el UID a mano (un campo tenantId
    // suelto en un where() se puede olvidar; una subcolección con esta regla,
    // no). request.auth.token.tenantId es la forma de claim que el goal 14
    // recién va a EMITIR (setUserRole) -- esta regla ya la exige desde ahora,
    // a propósito: no hace falta que exista el callable que la emite para que
    // la regla esté lista y probada (ver tests/rules/tenant-isolation.rules.test.js,
    // que la ejercita con claims sintéticos vía authenticatedContext()).
    //
    // Deliberadamente SIN roles todavía (owner/reception/staff+resourceId,
    // goal 14) ni excepción de platformRole:'superadmin' (goal 7/8) -- goal 6
    // solo pide aislamiento tenant-vs-tenant, no control de acceso fino
    // dentro de un mismo tenant. Agregar esos dos es trabajo de goals
    // posteriores, no de este.
    //
    // NO reemplaza services/staff/bookings de más arriba: esas colecciones
    // de nivel raíz siguen siendo las que usa Scissor White en producción
    // hoy (proyecto GCP `scissor-white`, separado a propósito del proyecto
    // de la plataforma -- ver README.md#Contexto:-Micelio). El corte real de
    // esas colecciones a esta ruta es el goal 17 (migración), no este.
    //
    // Goal 8: un tenant 'suspended' bloquea la ESCRITURA de sus propios
    // usuarios de negocio de inmediato -- isTenantSuspended() hace un get()
    // extra a tenants/{tenantId} (única forma de que una regla vea otro
    // documento). A propósito NO se bloquea la LECTURA: el goal exige que
    // suspender "no borre ni oculte" los datos del tenant, así que su equipo
    // sigue pudiendo ver su propio historial mientras está suspendido, solo
    // no puede seguir operando.
    function isTenantSuspended(tenantId) {
      let tenantPath = /databases/$(database)/documents/tenants/$(tenantId);
      // exists() primero: get().data en un documento inexistente es un error
      // de evaluación (deniega toda la regla), no `null` -- y los tests del
      // goal 6 ejercitan el aislamiento con claims sintéticos SIN sembrar un
      // tenants/{tenantId} real. Un tenant sin documento (o sin `status`
      // todavía) se trata como NO suspendido -- fail open acá, fail closed
      // ya lo garantiza el chequeo de tenantId de la regla de abajo.
      return exists(tenantPath) && get(tenantPath).data.status == 'suspended';
    }
    match /tenants/{tenantId}/{collection}/{docId} {
      // auditLog NO está en esta lista a propósito (goal 15, más abajo):
      // tiene su propia regla, más estricta (lectura solo owner/superadmin,
      // escritura nunca desde el cliente) -- dejarla acá también habría
      // hecho que la regla genérica (más permisiva) ganara por OR, como
      // pasa con cualquier `match` que se solapa en Firestore.
      function inTenantCollections() {
        return collection in ['resources', 'services', 'bookings', 'holds', 'dataRequests']
          && request.auth != null && request.auth.token.tenantId == tenantId;
      }

      // ══ ROLES DE NEGOCIO (Etapa A, goal 14 del pool ReservaGo) ══
      // owner/reception ven todo su tenant, igual que cualquier claim con
      // tenantId ya podía desde el goal 6 -- el goal 14 solo agrega una
      // restricción ADICIONAL para 'staff': acotado a los bookings donde
      // SU PROPIO resourceId aparece en resourceIds[] (goal 9/10/11).
      // Ninguna otra colección (resources/services/holds/dataRequests) se
      // restringe por role -- el goal solo pide acotar bookings (auditLog
      // ya tiene su propia regla, ver goal 15 más abajo). .get('resourceIds', [])
      // es seguro ante un doc que no
      // trajera ese campo (mismo patrón que isValidEmail() más arriba en
      // este archivo, con request.resource.data.get(...)).
      //
      // LIMITACIÓN CONOCIDA: esto solo puede aplicar a get/create/update/
      // delete (un documento concreto) -- Firestore NO permite filtrar
      // documentos individuales dentro de un `list` (query) vía reglas,
      // solo permitir o denegar la query completa. `list` sigue acotado
      // únicamente por tenantId; que un 'staff' solo vea SUS bookings en
      // una lista depende de que el cliente arme la query con
      // where('resourceIds','array-contains',resourceId) -- por
      // convención, no por regla. Documentado a propósito, no es un
      // descuido.
      // request.auth.token.get(key, default) -- NUNCA request.auth.token.key
      // a secas: la mayoría de los claims sintéticos en tests (y tokens
      // reales de antes del goal 14) no traen `role` en absoluto, y acceder
      // a una key ausente del mapa de un token revienta la evaluación
      // (mismo motivo que bookingData.get('resourceIds', []) más abajo).
      function staffOwnsBooking(bookingData) {
        return request.auth.token.get('role', '') != 'staff'
          || (bookingData != null
              && bookingData.get('resourceIds', []).hasAny([request.auth.token.get('resourceId', '')]));
      }
      function bookingAccessOk(bookingData) {
        return collection != 'bookings' || staffOwnsBooking(bookingData);
      }

      // resource == null (documento inexistente, ej. un ID que nunca
      // existió) se deja pasar la comprobación de rol -- Firestore ya
      // resuelve "no existe" del lado del cliente (exists:false); acá solo
      // interesa no reventar la evaluación de la regla accediendo a
      // resource.data sobre un resource nulo, mismo criterio que
      // isTenantSuspended() usa exists() antes de get().data.
      allow get: if inTenantCollections() && (resource == null || bookingAccessOk(resource.data));
      allow list: if inTenantCollections();
      // stamped() (goal 15, ver más arriba) en create/update -- el trigger
      // de auditLog (functions/index.js#onTenantSubcollectionWritten) lee
      // `updatedBy` del documento para atribuir cada fila a su autor real;
      // sin esto cualquiera podría mentir sobre quién hizo un cambio, igual
      // que ya se exige para tenants/{tenantId} desde el goal 8. No aplica
      // a `delete` -- no hay request.resource.data que estampar en un
      // borrado (bookings ya no borra nunca desde el goal 13; el resto de
      // colecciones si acaso deja de existir, no queda un before/after que
      // atribuir del mismo modo).
      allow create: if inTenantCollections() && !isTenantSuspended(tenantId) && stamped() && bookingAccessOk(request.resource.data);
      allow update: if inTenantCollections() && !isTenantSuspended(tenantId) && stamped()
        && (resource == null || bookingAccessOk(resource.data));
      allow delete: if inTenantCollections() && !isTenantSuspended(tenantId)
        && (resource == null || bookingAccessOk(resource.data));
    }

    // ══ BITÁCORA DE NEGOCIO (Etapa A, goal 15 del pool ReservaGo) ══
    // tenants/{tenantId}/auditLog/{id}: actorUid, actorRole, action,
    // collection, docId, before, after, source, ts (serverTimestamp).
    // Escrita SOLO por el trigger onTenantSubcollectionWritten (Admin SDK,
    // no sujeto a estas reglas) -- igual que platformAuditLog (goal 8), la
    // bitácora no depende de que el panel "se acuerde" de loguear (ver el
    // bug ya conocido de adminLog en CLAUDE.md, ahora obsoleto). Lectura
    // solo el owner de ESE tenant o un superadmin -- reception/staff no ven
    // la bitácora de auditoría del negocio.
    function isTenantOwner(tenantId) {
      return request.auth != null && request.auth.token.get('role', '') == 'owner'
        && request.auth.token.tenantId == tenantId;
    }
    match /tenants/{tenantId}/auditLog/{id} {
      allow read: if isTenantOwner(tenantId) || isSuperadmin();
      allow write: if false;
    }
  }
}
